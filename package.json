{
  "name": "coremind",
  "version": "0.1.0",
  "description": "CoreMind - AI-Native Desktop Development Environment for macOS and Windows",
  "main": "dist-electron/main.js",
  "author": "CoreMind Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite",
    "build": "tsc --noEmit && NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:win": "npm run build && electron-builder --win",
    "package": "npm run build && electron-builder --mac --arm64 --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"try { require('child_process').execSync('chmod +x node_modules/node-pty/prebuilds/*/*helper* 2>/dev/null'); } catch(e) {}\""
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^37.3.0",
    "@codingame/monaco-vscode-configuration-service-override": "^37.3.0",
    "@codingame/monaco-vscode-dialogs-service-override": "^37.3.0",
    "@codingame/monaco-vscode-editor-service-override": "^37.3.0",
    "@codingame/monaco-vscode-environment-service-override": "^37.3.0",
    "@codingame/monaco-vscode-explorer-service-override": "^37.3.0",
    "@codingame/monaco-vscode-files-service-override": "^37.3.0",
    "@codingame/monaco-vscode-keybindings-service-override": "^37.3.0",
    "@codingame/monaco-vscode-layout-service-override": "^37.3.0",
    "@codingame/monaco-vscode-lifecycle-service-override": "^37.3.0",
    "@codingame/monaco-vscode-quickaccess-service-override": "^37.3.0",
    "@codingame/monaco-vscode-textmate-service-override": "^37.3.0",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "^37.3.0",
    "@codingame/monaco-vscode-theme-service-override": "^37.3.0",
    "@codingame/monaco-vscode-theme-seti-default-extension": "^37.3.0",
    "@codingame/monaco-vscode-views-service-override": "^37.3.0",
    "@codingame/monaco-vscode-workbench-service-override": "^37.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@typefox/monaco-editor-react": "^8.0.2",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^37.3.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7"
  },
  "build": {
    "appId": "com.coremind.ide",
    "productName": "CoreMind",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "assets",
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0.0",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "CoreMind Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
